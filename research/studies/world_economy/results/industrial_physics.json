  "evidence": "Closed-form pressure-inventory, illustrative retained-air loading, ideal membrane/buckling and mechanical-energy calculations. No atmosphere commissioning simulation, certified structure, process qualification, construction estimate or commercial forecast.",
  "sources": {
    "pressure_vessels": {
      "title": "Pressure Vessels",
      "author": "David Roylance, MIT",
      "date": "2001-08-23",
      "url": "https://ocw.mit.edu/courses/3-11-mechanics-of-materials-fall-1999/082fcd712adffa589a670f9f8dfdd49a_MIT3_11F99_pv.pdf",
      "accessed": "2026-10-31",
      "scope": "Targeted reading pp. 2-4, Eqs. 1-3: thin spherical and cylindrical membrane stresses. Material properties, radii and enclosure pressures below are independent illustrative assumptions."
    },
    "spherical_buckling": {
      "title": "Nonlinear buckling behaviour of spherical shells: barriers and symmetry-breaking dimples",
      "authors": "John W. Hutchinson and J. Michael T. Thompson",
      "year": 2017,
      "doi": "10.1098/rsta.2016.0154",
      "url": "https://groups.seas.harvard.edu/hutchinson/papers/2017-7-PerfectSpheres.pdf",
      "accessed": "2026-10-31",
      "scope": "Targeted reading pp. 1-3: classical perfect-sphere elastic pressure and strong imperfection sensitivity. The 0.2 reduction below is an illustration, not a transferred design rule or safety factor."
    },
    "anthropogenic_exosphere": {
      "title": "Temporary atmospheres produced by human activities on the Moon",
      "authors": "Rosemary M. Killen, Benjamin T. Sprague and William M. Farrell",
      "year": 2024,
      "doi": "10.1016/j.asr.2024.08.042",
      "url": "https://ntrs.nasa.gov/api/citations/20240014015/downloads/KillenTemporarySTI.pdf?attachment=true",
      "accessed": "2026-10-31",
      "scope": "Targeted reading abstract and sections 1-2: local gas from exhaust, airlocks, equipment and mining; surface adsorption and composition matter. These near-term local calculations do not simulate planetary atmosphere construction."
    },
    "habitat_environment": {
      "title": "Strategies for the design and operation of resilient extraterrestrial habitats",
      "authors": "Shirley J. Dyke et al.",
      "year": 2021,
      "url": "https://ntrs.nasa.gov/api/citations/20220005431/downloads/2021.03%20-%20SPIE%20-%20Strategies%20for%20the%20Design%20and%20Operation%20of%20Resilient%20Extraterrestrial%20Habitats.pdf?attachment=true",
      "accessed": "2026-10-31",
      "scope": "Targeted reading section 2.1: independent pressure containment, reduced self-weight, dynamic response and environmental requirements. No design validation or capital cost supplied."
    },
    "eb_welding_pressure": {
      "title": "Reduced Pressure Electron Beam Welding in the Power Generation Industry",
      "author": "C. S. Punshon, TWI",
      "year": 2004,
      "url": "https://www.twi-global.com/technical-knowledge/published-papers/reduced-pressure-electron-beam-welding-in-the-power-generation-industry",
      "accessed": "2026-10-31",
      "scope": "Targeted reading Introduction, Reduced pressure EB welding and Concluding remarks. Conventional working pressure around 0.001 mbar = 0.1 Pa; specially developed differential pumping permits working pressure up to about 1 mbar = 100 Pa. Gun vacuum and workpiece atmosphere differ; these are specific welding cases, not universal manufacturing limits."
    },
    "eb_welding_faq": {
      "title": "What is electron beam welding at reduced pressure?",
      "author": "TWI",
      "url": "https://www.twi-global.com/technical-knowledge/faqs/faq-what-is-electron-beam-welding-at-reduced-pressure",
      "accessed": "2026-10-31",
      "scope": "Complete short substantive FAQ. Quotes about 0.001 mbar for conventional >75 mm thick-section welding, and 1-10 mbar for a special gun up to 150 mm. The 100-1000 Pa range is process-specific; no inference of lunar processing qualification."
    },
    "nasa_ebf3_rates": {
      "title": "Electron Beam Freeform Fabrication: A Rapid Metal Deposition Process",
      "authors": "Karen M. B. Taminger and Robert A. Hafley, NASA Langley",
      "year": 2003,
      "url": "https://ntrs.nasa.gov/api/citations/20040042496/downloads/20040042496.pdf",
      "accessed": "2026-10-31",
      "scope": "Targeted reading abstract and Electron Beam Deposition section, pp. 1-3. Demonstrated deposition rates 330-2500 cm3/hour; fine-detail/rate tradeoff. No future upper rate limit, lunar production test or complete factory system established."
    }
