+      
       imm=0; ibdef=10; ihot=0; ihydraulics=0; izonal5=0; slam0=-124._rkind; sfea0=45._rkind; 
       ihdif=0; thetai=0.6_rkind; drampbc=0.d0
       dramp=1._rkind; nadv=1; dtb_min=10._rkind; dtb_max=30._rkind; h0=0.01_rkind; nchi=0; dzb_min=0.5_rkind 
@@ -2306,6 +2307,43 @@
       read(31,*) !start_time
 !...  Earth tidal potential
       read(31,*) ntip,tip_dp !cut-off depth for applying tidal potential
+!     Terluna lunar build: Earth's constituents (species patterns and the 0.69 Love factor) do not apply,
+!     and sflux's bulk formulas still carry Earth's gravity; the Moon's tide comes from ilunartide=1
+      if(ntip>0) call parallel_abort('INIT: lunar build, set ntip=0 and use ilunartide=1 for the tide')
+      if(nws==2) call parallel_abort('INIT: lunar build, sflux (nws=2) carries Earth constants; audit it first')
+      if(ilunartide==1) then
+        if(myrank==0) then
+          open(32,file=in_dir(1:len_in_dir)//'lunar_tide.th',status='old')
+          read(32,*) ntide_rec,ntide_coef,tide_dt_th
+        endif
+        call mpi_bcast(ntide_rec,1,itype,0,comm,istat)
+        call mpi_bcast(ntide_coef,1,itype,0,comm,istat)
+        call mpi_bcast(tide_dt_th,1,rtype,0,comm,istat)
+        if(ntide_rec<2.or.ntide_coef<1.or.tide_dt_th<=0.d0) call parallel_abort('INIT: check lunar_tide.th')
+        allocate(tide_coef_th(ntide_coef,ntide_rec),tide_basis(ntide_coef,npa),ctide(ntide_coef), &
+     &tide_buf(ntide_coef,np_global),stat=istat)
+        if(istat/=0) call parallel_abort('INIT: alloc failure for the lunar tide')
+        if(myrank==0) then
+          do j=1,ntide_rec
+            read(32,*) tide_coef_th(:,j)
+          enddo !j
+          close(32)
+          open(32,file=in_dir(1:len_in_dir)//'lunar_tide_basis.in',status='old')
+          read(32,*) itmp1,itmp2
+          if(itmp1/=np_global.or.itmp2/=ntide_coef) call parallel_abort('INIT: check lunar_tide_basis.in')
+          do i=1,np_global
+            read(32,*) tide_buf(:,i)
+          enddo !i
+          close(32)
+        endif !myrank
+        call mpi_bcast(tide_coef_th,ntide_coef*ntide_rec,rtype,0,comm,istat)
+        call mpi_bcast(tide_buf,ntide_coef*np_global,rtype,0,comm,istat)
+        tide_basis=0.d0
+        do i=1,np_global
+          if(ipgl(i)%rank==myrank) tide_basis(:,ipgl(i)%id)=tide_buf(:,i)
+        enddo !i
+        deallocate(tide_buf)
+      endif !ilunartide
       if(ntip>0) then
         !Alloc local arrays separately to avoid crash under ESMF-PDAF flexible mode ensemble
         if(.not.allocated(tp_name)) allocate(tp_name(ntip),stat=istat)
diff -ruN a/src/Hydro/schism_step.F90 b/src/Hydro/schism_step.F90
--- a/src/Hydro/schism_step.F90
+++ b/src/Hydro/schism_step.F90
@@ -429,6 +429,15 @@
         ramp=1.d0
       endif
 
+!     Terluna lunar tide: the coefficients at this time, linear between records
+      if(ilunartide==1) then
+        tmp1=time/tide_dt_th
+        if(tmp1>real(ntide_rec-1,rkind)+1.d-6) call parallel_abort('STEP: the run outlasts lunar_tide.th')
+        itmp1=min(max(int(tmp1),0),ntide_rec-2)
+        tmp2=min(max(tmp1-real(itmp1,rkind),0.d0),1.d0)
+        ctide(:)=(1.d0-tmp2)*tide_coef_th(:,itmp1+1)+tmp2*tide_coef_th(:,itmp1+2)
+      endif
+
 !$OMP parallel default(shared) private(i,j,ncyc,arg)
 
 !...  Compute new bed deformation
@@ -443,6 +452,7 @@
 !$OMP do
       do i=1,npa
         etp(i)=0.d0
+        if(ilunartide==1) etp(i)=ramp*sum(ctide(1:ntide_coef)*tide_basis(1:ntide_coef,i)) !Terluna lunar tide
         do j=1,ntip
           ncyc=int(tfreq(j)*time/2.d0/pi)
           arg=tfreq(j)*time-real(ncyc,rkind)*2.d0*pi+jspc(j)*xlon(i)+tear(j)
